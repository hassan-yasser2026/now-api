{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": false
      }
    },
    "customer": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "customer"
      }
    },
    "vendor": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "vendor"
      }
    },
    "delivery": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "delivery"
      }
    },
    "customer-production": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "customer"
      }
    },
    "vendor-production": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "vendor"
      }
    },
    "delivery-production": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_ROLE": "delivery"
      }
    },
    "production": {
      "autoIncrement": false,
      "android": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.now-eg.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
