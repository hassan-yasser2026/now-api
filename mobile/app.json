{
  "expo": {
    "name": "Goody Star",
    "slug": "goody-star",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "now-delivery",
    "icon": "./assets/images/goody-star-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.now.delivery",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "يستخدم چودي ستار موقعك لتحديد عنوان الاستلام أو التوصيل وتحسين تجربة الطلب."
      }
    },
    "android": {
      "package": "com.now.delivery",
      "versionCode": 13,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/goody-star-foreground.png",
        "backgroundImage": "./assets/images/goody-star-background.png",
        "monochromeImage": "./assets/images/goody-star-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/goody-star-icon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم چودي ستار موقعك لتحديد عنوان الاستلام أو التوصيل وتحسين تجربة الطلب."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/goody-star-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "13a5b445-4140-4f6c-88c9-a38ca31b28ff"
      }
    },
    "owner": "hassan-yasser2026"
  }
}
