generator client {
  provider = "prisma-client-js"
}

model Offer {
  id              Int              @id @default(autoincrement())
  storeId         Int
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  discountType    String           @default("PERCENTAGE")
  discountValue   Decimal          @db.Decimal(12, 2)
  image           String?
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean          @default(true)
  approvalStatus  SubmissionStatus @default(PENDING_ADMIN_REVIEW)
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([storeId, approvalStatus, isActive])
  @@map("offers")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                  Int                  @id @default(autoincrement())
  phone               String               @unique
  password            String
  name                String
  email               String?              @unique
  profileImage        String?
  idImage             String?
  motorcycleImage     String?
  motorcycleCardImage String?
  latitude            Decimal?             @db.Decimal(9, 6)
  longitude           Decimal?             @db.Decimal(9, 6)
  isActive            Boolean              @default(true)
  suspensionReason    String?
  suspendedUntil      DateTime?
  deletedAt           DateTime?
  phoneVerified       Boolean              @default(false)
  approvalStatus      SubmissionStatus    @default(APPROVED)
  rejectionReason     String?
  notificationsEnabled Boolean             @default(true)
  roleId              Int
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  store               Store?
  addresses           Address[]
  orders              Order[]              @relation("CustomerOrders")
  deliveries          Order[]              @relation("DeliveryOrders")
  deliveryProfile     DeliveryProfile?
  favorites           Favorite[]
  notifications       Notification[]
  wallet              Wallet?
  otpVerifications    OtpVerification[]
  adminProfile        Admin?
  subAdminPermissions SubAdminPermission[] @relation("SubAdminPermissions")
  grantedPermissions  SubAdminPermission[] @relation("GrantedSubAdminPermissions")
  auditLogs           AuditLog[]           @relation("AuditActor")
  chatSessions        ChatSession[]
  ratings             Rating[]       @relation("CustomerRatings")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@map("roles")
}

model Permission {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  description         String?
  roles               RolePermission[]
  subAdminPermissions SubAdminPermission[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Admin {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model SubAdminPermission {
  subAdminId   Int
  permissionId Int
  grantedById  Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  subAdmin     User       @relation("SubAdminPermissions", fields: [subAdminId], references: [id], onDelete: Cascade)
  grantedBy    User       @relation("GrantedSubAdminPermissions", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@id([subAdminId, permissionId])
  @@index([permissionId])
  @@map("sub_admin_permissions")
}

model StoreCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nameAr    String?
  image     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("store_categories")
}

model Store {
  id             Int                @id @default(autoincrement())
  vendorId       Int                @unique
  vendor         User               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryId     Int?
  category       StoreCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  isOpen         Boolean            @default(true)
  isActive       Boolean            @default(true)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  image          String?
  operatingHours Json?
  approvalStatus SubmissionStatus @default(APPROVED)
  rejectionReason String?
  menuItems      MenuItem[]
  menuCategories MenuItemCategory[]
  orders         Order[]
  offers         Offer[]
  favorites      Favorite[]
  ratings        Rating[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([categoryId])
  @@index([isActive, isOpen])
  @@map("stores")
}

model MenuItemCategory {
  id          Int        @id @default(autoincrement())
  storeId     Int
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isActive, sortOrder])
  @@map("menu_item_categories")
}

model MenuItem {
  id          Int               @id @default(autoincrement())
  storeId     Int
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    MenuItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  nameAr      String?
  description String?
  price       Decimal           @db.Decimal(12, 2)
  isAvailable Boolean           @default(true)
  image       String?
  approvalStatus SubmissionStatus @default(APPROVED)
  rejectionReason String?
  orderItems    OrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([storeId, isAvailable])
  @@index([categoryId])
  @@map("menu_items")
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  recipient    String
  phone        String
  line1        String
  line2        String?
  city         String
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  instructions String?
  isDefault    Boolean  @default(false)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("addresses")
}

model DeliveryProfile {
  id           Int                  @id @default(autoincrement())
  userId       Int                  @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DeliveryAvailability @default(OFFLINE)
  vehicleType  String?
  vehiclePlate String?
  latitude     Decimal?             @db.Decimal(9, 6)
  longitude    Decimal?             @db.Decimal(9, 6)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
  @@map("delivery_profiles")
}

model Order {
  id                  Int                  @id @default(autoincrement())
  customerId          Int
  customer            User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  storeId             Int
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  deliveryId          Int?
  delivery            User?                @relation("DeliveryOrders", fields: [deliveryId], references: [id], onDelete: SetNull)
  addressId           Int?
  savedAddress        Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  address             String               @map("address")
  deliveryLat         Decimal?             @db.Decimal(9, 6)
  deliveryLng         Decimal?             @db.Decimal(9, 6)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  status              OrderStatus          @default(PENDING)
  subtotal            Decimal              @default(0) @db.Decimal(12, 2)
  deliveryFee         Decimal              @default(0) @db.Decimal(12, 2)
  platformCommission  Decimal              @default(0) @db.Decimal(12, 2)
  totalPrice          Decimal              @db.Decimal(12, 2)
  paymentTransactions PaymentTransaction[]
  walletTransactions WalletTransaction[]
  scheduledAt         DateTime?
  chatSessions        ChatSession[]
  rating              Rating?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([customerId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([deliveryId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model Rating {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId Int
  customer   User     @relation("CustomerRatings", fields: [customerId], references: [id], onDelete: Restrict)
  storeId    Int
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId, createdAt])
  @@map("ratings")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   Int
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity     Int
  priceAtOrder Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@index([menuItemId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  actorId   Int?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model PaymentTransaction {
  id        Int           @id @default(autoincrement())
  orderId   Int
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("EGP")
  status    PaymentStatus @default(PENDING)
  method    String?
  gatewayId String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderId])
  @@map("payment_transactions")
}

model Favorite {
  userId    Int
  storeId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, storeId])
  @@index([storeId])
  @@map("favorites")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model OtpVerification {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("otp_verifications")
}

model Wallet {
  id           Int               @id @default(autoincrement())
  userId       Int               @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal           @default(0) @db.Decimal(12, 2)
  transactions WalletTransaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  walletId    Int
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(12, 2)
  type        String
  description String
  createdAt   DateTime @default(now())

  @@index([walletId, createdAt])
  @@unique([walletId, orderId, type])
  @@map("wallet_transactions")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  orderId   Int?
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ChatStatus    @default(OPEN)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    SenderType
  message   String
  isBot     Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum DeliveryAvailability {
  AVAILABLE
  OFFLINE
  BUSY
  SUSPENDED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_STATUS
  PROMOTION
  SYSTEM
}

enum ChatStatus {
  OPEN
  RESOLVED
  ESCALATED
}

enum SenderType {
  USER
  BOT
  ADMIN
}
