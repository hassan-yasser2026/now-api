PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/now"
JWT_SECRET="your_secret_key_here"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8081"
# Use true only behind a trusted reverse proxy or load balancer.
TRUST_PROXY="false"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
